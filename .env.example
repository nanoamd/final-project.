# ---------------------------------------------------------------------------
# Environment variables
#
# Copy this file to `.env.local` and fill in real values for local development:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. This `.env.example` is committed and must list
# EVERY variable the app reads (see src/env.ts), with placeholder values only —
# never commit real secrets.
#
# Validation lives in src/env.ts. Variables prefixed NEXT_PUBLIC_ are exposed to
# the browser; all others are server-only.
# ---------------------------------------------------------------------------

# App ------------------------------------------------------------------------
# Canonical base URL of the app (no trailing slash).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase -------------------------------------------------------------------
# Project URL and public anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key — server-only, full database access. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# Sanity CMS -----------------------------------------------------------------
# Create a project at sanity.io/manage, then copy its Project ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Pin the API version to a date (YYYY-MM-DD) for stable, reproducible queries.
NEXT_PUBLIC_SANITY_API_VERSION="2025-01-01"
# Read token for authenticated/preview content — server-only.
SANITY_API_READ_TOKEN=""
# Optional — only needed to enable the /api/revalidate webhook (every page
# already has a 60s ISR floor without it). Any random string — set the same
# value in Sanity's webhook config.
SANITY_REVALIDATE_SECRET=""
# NOT validated by src/env.ts (read directly via process.env). Needed to run
# `scripts/seed-sanity.ts`, and at runtime for the contact form and the admin
# product importer. Create a token with "Editor" permission under the
# project's API settings at sanity.io/manage.
SANITY_API_WRITE_TOKEN=""

# Stripe ---------------------------------------------------------------------
# Publishable key (safe for the browser).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Secret key and webhook signing secret — server-only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI garden visualiser tool ---------------------------------------------------
# Optional — only needed for the /tools/garden-visualiser tool. Without it,
# that one tool shows an "unavailable" state; nothing else is affected.
# Create a key at platform.openai.com.
OPENAI_API_KEY=""
# Optional — signs the anonymous per-visitor usage cookie for that tool. Any
# random string. Falls back to a fixed in-code value if unset (non-critical).
RATE_LIMIT_SECRET=""

# Admin ------------------------------------------------------------------------
# Optional — the one Supabase account allowed into /admin (product URL
# importer). Create a Supabase user with this exact email at
# supabase.com/dashboard (Authentication > Users > Add user) — there's no
# self-signup. Without this set, /admin is unreachable for everyone.
ADMIN_EMAIL=""

# Google Sheets import log (optional) -----------------------------------------
# Logs every URL import (see /admin/import) to a Google Sheet: one row per
# import in an "Import Log" tab, and each supplier's product-page links
# collected in a "Suppliers" tab for easy reordering later. Without all three
# set, the importer just skips this step — nothing else is affected.
#
# Setup:
#   1. Create a Google Sheet with two tabs named exactly "Import Log" and
#      "Suppliers" (this app only appends/updates rows in tabs that already
#      exist — it never creates one for you).
#   2. Google Cloud Console (console.cloud.google.com) > a project > APIs &
#      Services > Enable the "Google Sheets API" > Credentials > Create
#      Credentials > Service Account. Give it any name.
#   3. Open the new service account > Keys > Add Key > Create new key > JSON.
#      That downloaded file has "client_email" and "private_key" fields —
#      copy those into the two vars below.
#   4. Back in your Google Sheet, click Share, and share it with the
#      service account's email address (the "client_email" value) as an
#      Editor — service accounts aren't people, so they need to be invited
#      like any other collaborator.
#   5. The spreadsheet ID is the long string in the sheet's URL, between
#      "/d/" and "/edit".
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_CLIENT_EMAIL=""
# Paste the "private_key" value from the downloaded JSON file exactly as-is,
# including the literal \n sequences and BEGIN/END lines.
GOOGLE_SHEETS_PRIVATE_KEY=""

# Newsletter confirmation email (optional) -------------------------------------
# Sends a real welcome email when someone subscribes via the newsletter form.
# Without it, subscribing still saves the email to Sanity — it just skips
# sending anything.
#
# Setup:
#   1. Create a free account at resend.com, then Dashboard > API Keys >
#      Create API Key.
#   2. RESEND_FROM_EMAIL is optional — Resend's shared onboarding@resend.dev
#      sender works out of the box, but can only deliver to your own Resend
#      account email until you verify a domain (Dashboard > Domains > Add
#      Domain, e.g. kaikuhome.com). Once verified, set this to an address on
#      that domain, e.g. "Kaiku <hello@kaikuhome.com>".
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Analytics & site verification ------------------------------------------------
# All optional — each renders nothing until set, so it's safe to ship ahead of
# actually having accounts with these services.
# Google Analytics 4 measurement ID (analytics.google.com). Gated behind the
# cookie consent banner — only loads once a visitor accepts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Google Search Console: Settings > Ownership verification > HTML tag method,
# copy just the content="..." value (search.google.com/search-console).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools: same HTML-tag method, content value only
# (bing.com/webmasters).
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# Pinterest: Settings > Claim > Claim website, HTML tag method, content value
# only (business.pinterest.com).
NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION=""
# Meta/Facebook Pixel ID (business.facebook.com/events_manager). Gated behind
# the cookie consent banner, same as Google Analytics.
NEXT_PUBLIC_META_PIXEL_ID=""
