# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented example committed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
.image-work/
.audit/

# Regenerated on every audit run; the CSV beside it carries the same rows
# and is the readable one. Committing both churned 89,000 lines per run,
# because prettier reformats it and the script rewrites it minified.
docs/change-log/remediation-items.json

# Throwaway investigation scripts. Anything worth keeping becomes a real
# script in scripts/ with a comment explaining why it exists.
.tmp-*
